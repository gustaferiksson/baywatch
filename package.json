{
    "name": "baywatch",
    "version": "0.0.1",
    "private": true,
    "description": "Task-centric, multi-repo AI coding-agent cockpit (native macOS) — sandboxed Claude sessions over podman",
    "type": "module",
    "bin": {
        "baywatch": "./src/cli.ts"
    },
    "scripts": {
        "baywatch": "bun run src/cli.ts",
        "dev": "bun run --hot src/cli.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && bun run typecheck",
        "install:specs": "bun build src/specs/*.ts --outdir ~/.fig/autocomplete/build --minify --format esm"
    },
    "dependencies": {
        "@clack/prompts": "1.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.13",
        "@types/bun": "1.3.13",
        "@withfig/autocomplete-types": "1.31.0",
        "typescript": "6.0.3"
    }
}
