{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build extension",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}/vscode" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "watch extension",
      "type": "shell",
      "command": "bun run watch",
      "options": { "cwd": "${workspaceFolder}/vscode" },
      "isBackground": true,
      "group": "build",
      "problemMatcher": "$tsc-watch"
    }
  ]
}
