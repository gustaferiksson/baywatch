{
    "name": "baywatch-vscode",
    "displayName": "Baywatch",
    "description": "VS Code surface for the baywatch agent orchestrator. Talks to the `baywatch` CLI; CLI is the source of truth.",
    "version": "0.0.2",
    "publisher": "gustaferiksson",
    "private": false,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gustaferiksson/baywatch"
    },
    "engines": {
        "vscode": "^1.118.0"
    },
    "main": "./dist/extension.js",
    "categories": [
        "Other"
    ],
    "keywords": [
        "claude",
        "agent",
        "automation",
        "github"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "baywatch",
                    "title": "Baywatch",
                    "icon": "$(rocket)"
                }
            ]
        },
        "views": {
            "baywatch": [
                {
                    "id": "baywatch.runs",
                    "name": "Runs"
                },
                {
                    "id": "baywatch.reviews",
                    "name": "Reviews"
                }
            ]
        },
        "commands": [
            {
                "command": "baywatch.runDev",
                "title": "Baywatch: Run dev agent",
                "icon": "$(play)"
            },
            {
                "command": "baywatch.runReview",
                "title": "Baywatch: Run review agent",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "baywatch.refreshRuns",
                "title": "Baywatch: Refresh",
                "icon": "$(refresh)"
            },
            {
                "command": "baywatch.tailLog",
                "title": "Baywatch: Tail log",
                "icon": "$(output)"
            },
            {
                "command": "baywatch.openLog",
                "title": "Baywatch: Open log file"
            },
            {
                "command": "baywatch.openClone",
                "title": "Baywatch: Open agent clone in new window",
                "icon": "$(window)"
            },
            {
                "command": "baywatch.openReview",
                "title": "Baywatch: Open review markdown",
                "icon": "$(go-to-file)"
            },
            {
                "command": "baywatch.retryRun",
                "title": "Baywatch: Retry run",
                "icon": "$(debug-restart)"
            },
            {
                "command": "baywatch.runDoctor",
                "title": "Baywatch: Run doctor (preflight check)"
            },
            {
                "command": "baywatch.editNotesForIssue",
                "title": "Baywatch: Edit notes for issue…",
                "icon": "$(edit)"
            },
            {
                "command": "baywatch.editNotesForPR",
                "title": "Baywatch: Edit notes for PR…",
                "icon": "$(edit)"
            },
            {
                "command": "baywatch.startClaudeSession",
                "title": "Baywatch: Start Claude session here",
                "icon": "$(zap)"
            },
            {
                "command": "baywatch.pushBranch",
                "title": "Baywatch: Push agent branch",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "baywatch.openPR",
                "title": "Baywatch: Open PR for agent branch",
                "icon": "$(git-pull-request)"
            },
            {
                "command": "baywatch.imageBuild",
                "title": "Baywatch: Rebuild sandbox image"
            },
            {
                "command": "baywatch.cleanClones",
                "title": "Baywatch: Clean old agent clones"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "baywatch.runDev",
                    "when": "view == baywatch.runs",
                    "group": "navigation@1"
                },
                {
                    "command": "baywatch.runReview",
                    "when": "view == baywatch.runs",
                    "group": "navigation@2"
                },
                {
                    "command": "baywatch.startClaudeSession",
                    "when": "view == baywatch.runs",
                    "group": "navigation@3"
                },
                {
                    "command": "baywatch.refreshRuns",
                    "when": "view == baywatch.runs || view == baywatch.reviews",
                    "group": "navigation@99"
                }
            ],
            "view/item/context": [
                {
                    "command": "baywatch.tailLog",
                    "when": "view == baywatch.runs",
                    "group": "inline@1"
                },
                {
                    "command": "baywatch.openClone",
                    "when": "view == baywatch.runs && viewItem == dev-run",
                    "group": "inline@2"
                },
                {
                    "command": "baywatch.openReview",
                    "when": "view == baywatch.runs && viewItem == review-run",
                    "group": "inline@2"
                },
                {
                    "command": "baywatch.retryRun",
                    "when": "view == baywatch.runs",
                    "group": "inline@3"
                },
                {
                    "command": "baywatch.openLog",
                    "when": "view == baywatch.runs",
                    "group": "1_view"
                },
                {
                    "command": "baywatch.openClone",
                    "when": "view == baywatch.runs && viewItem == dev-run",
                    "group": "1_view"
                },
                {
                    "command": "baywatch.openReview",
                    "when": "view == baywatch.runs && viewItem == review-run",
                    "group": "1_view"
                },
                {
                    "command": "baywatch.retryRun",
                    "when": "view == baywatch.runs",
                    "group": "2_action"
                },
                {
                    "command": "baywatch.pushBranch",
                    "when": "view == baywatch.runs && viewItem == dev-run",
                    "group": "2_action"
                },
                {
                    "command": "baywatch.openPR",
                    "when": "view == baywatch.runs && viewItem == dev-run",
                    "group": "2_action"
                }
            ],
            "commandPalette": [
                {
                    "command": "baywatch.tailLog",
                    "when": "false"
                },
                {
                    "command": "baywatch.openLog",
                    "when": "false"
                },
                {
                    "command": "baywatch.openClone",
                    "when": "false"
                },
                {
                    "command": "baywatch.openReview",
                    "when": "false"
                },
                {
                    "command": "baywatch.retryRun",
                    "when": "false"
                },
                {
                    "command": "baywatch.pushBranch",
                    "when": "false"
                },
                {
                    "command": "baywatch.openPR",
                    "when": "false"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "tsc -p .",
        "watch": "tsc -p . --watch",
        "package": "vsce package --no-yarn",
        "publish": "vsce publish --no-yarn"
    },
    "devDependencies": {
        "@types/node": "22.10.5",
        "@types/vscode": "1.118.0",
        "@vscode/vsce": "3.9.1",
        "typescript": "6.0.3"
    }
}
