# Subscription auth (recommended) — bills your Claude subscription, no per-token charges.
# Get one with: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Pay-per-token API auth (alternative). Either is fine; CLAUDE_CODE_OAUTH_TOKEN takes precedence inside Claude Code.
# ANTHROPIC_API_KEY=

# GitHub auth: baywatch shells out to `gh` on the host (sandbox has no gh auth by design),
# so just `gh auth login` once. No GITHUB_TOKEN needed here.
